+++ ./.github/workflows/berty-manual-build.yml	2026-11-04 19:27:05.968473644 +0000
@@ -0,0 +1,99 @@
+name: Berty Manual Build
+
+on:
+  workflow_dispatch:
+    inputs:
+      app_env:
+        description: "APP_ENV (preview = 'Berty Staff', installs next to the Play Store version)"
+        type: choice
+        options:
+          - preview
+          - development
+          - production
+        default: preview
+
+jobs:
+  build:
+    name: Build Android APK
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0 # gomobile build embeds the version computed from git history
+
+      - name: Free disk space
+        run: |
+          # keep /usr/local/lib/android (SDK/NDK), the build needs it
+          sudo rm -rf /usr/share/dotnet /opt/ghc /usr/local/.ghcup /usr/local/share/boost /usr/share/swift
+          df -h /
+
+      - name: Setup Go (version from go.mod)
+        uses: actions/setup-go@v5
+        with:
+          go-version-file: go.mod
+          cache: true
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22.12.0 # same as .tool-versions, some deps require >= 20
+
+      - name: Setup Java
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 17
+
+      # Same Makefile target as the official android.yml workflow: builds
+      # berty-bridge-expo/android/libs/gobridge.aar (Go node + BLE glue) and
+      # installs the node modules of berty-bridge-expo
+      - name: Build gobridge.aar
+        working-directory: berty-bridge-expo
+        # gomobile runs 'go mod tidy' in a fresh module and asks sum.golang.org for every module,
+        # which sometimes fails with a network error ("stream error ... INTERNAL_ERROR"): retry
+        run: |
+          for attempt in 1 2 3; do
+            # last attempt: skip the checksum database lookups (only for this test build),
+            # the only thing that failed so far was the network call to sum.golang.org
+            if [ "$attempt" = "3" ]; then export GOSUMDB=off; fi
+            make android.gomobile && exit 0
+            echo "make android.gomobile failed (attempt $attempt of 3), retrying in 20 s"
+            sleep 20
+          done
+          exit 1
+
+      - name: Install app dependencies
+        working-directory: berty-bridge-expo/mobile
+        run: npm install
+
+      # The android/ project is not committed, it is generated here (this also runs
+      # the config plugins, including the manifest plugins of berty-bridge-expo)
+      - name: Expo prebuild
+        working-directory: berty-bridge-expo/mobile
+        env:
+          APP_ENV: ${{ inputs.app_env }}
+          CI: "1"
+        run: npx expo prebuild --platform android --no-install
+
+      - name: Build APK
+        working-directory: berty-bridge-expo/mobile/android
+        env:
+          APP_ENV: ${{ inputs.app_env }}
+          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -Dorg.gradle.daemon=false"
+        run: |
+          chmod +x gradlew
+          # gomobile only builds arm64 and amd64, so only build arm64 (real phones)
+          # ':app:' matters: a bare 'assembleRelease' also builds every library module as a
+          # standalone AAR, which fails for berty-bridge-expo (it embeds libs/gobridge.aar)
+          ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a --stacktrace
+
+      # The Expo template signs release builds with the debug keystore, which is fine
+      # for testing but not for publishing
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: berty-${{ inputs.app_env }}-apk
+          path: berty-bridge-expo/mobile/android/app/build/outputs/apk/release/*.apk
+          if-no-files-found: error
